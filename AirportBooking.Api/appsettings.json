{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "//": "Non-secret configuration only. Jwt:SigningKey and ConnectionStrings:Default live in user-secrets locally and in environment variables or a vault in production.",

  "Jwt": {
    "Issuer": "https://localhost:7167",
    "Audience": "skybook-client",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7,
    "RefreshCookieName": "skybook_rt"
  },

  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173", "https://localhost:5173" ]
  }
}
